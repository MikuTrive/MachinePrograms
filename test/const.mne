-- multiline const nested table demo

const TABLE = [
  [10, 20, 30],
  [40, 50, 60],
  [70, 80, 90]
]

const CUBE = [
  [
    [1, 2],
    [3, 4]
  ],
  [
    [5, 6],
    [7, 8]
  ]
]

main:
  print TABLE[0][0]
  print TABLE[1][2]
  print TABLE[2][1]

  print CUBE[0][1][0]
  print CUBE[1][0][1]
  print CUBE[1][1][1]

  ret 0
